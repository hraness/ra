{
  "name": "@hraness/ra",
  "version": "0.3.0",
  "description": "ra is an open-source visual QA CLI for coding agents. It checks responsive UI in Chromium and replays web and native user journeys.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hraness/ra.git"
  },
  "homepage": "https://hraness.github.io/ra/",
  "bugs": "https://github.com/hraness/ra/issues",
  "keywords": ["visual-qa", "ui-testing", "visual-testing", "design-qa", "coding-agents", "playwright", "chromium", "responsive-testing", "layout-testing", "accessibility-testing", "color-contrast", "network-mocking", "user-journeys", "agent-skills", "cli"],
  "bin": {
    "ra": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": ["dist", "skills", "docs"],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/unit.test.ts test/journeys.test.ts",
    "test:browser": "node --test --test-concurrency=1 test/browser.test.ts",
    "check": "bun run typecheck && bun run test && bun run build && node dist/cli.js --version && bun run test:site",
    "site": "rm -rf site/dist && bun site/build.ts",
    "test:site": "node --test test/site.test.ts",
    "figures": "node site/figures/render.ts"
  },
  "peerDependencies": {
    "playwright-core": ">=1.58"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hraness/analytics": "https://github.com/hraness/posthog/releases/download/v1.2.1/hraness-analytics-1.2.1.tgz",
    "@types/node": "24",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3"
  }
}
